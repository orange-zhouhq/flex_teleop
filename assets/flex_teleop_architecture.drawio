                <mxCell id="c_iklead" edge="1" parent="1" style="endArrow=none;html=1;strokeColor=#82b366;strokeWidth=1;dashed=1;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1305" y="700" as="sourcePoint"/>
                        <mxPoint x="1305" y="668" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c_ikt" parent="1" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#38761d;" value="QP IK 0.5ms" vertex="1">
                    <mxGeometry height="18" width="120" x="1245" y="646" as="geometry"/>
                </mxCell>
                <mxCell id="c_thr" edge="1" parent="1" style="endArrow=none;html=1;dashed=1;strokeColor=#c00000;strokeWidth=2;">
