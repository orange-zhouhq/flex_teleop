                    <mxGeometry height="65" width="540" x="1180" y="780" as="geometry"/>
                </mxCell>
                <mxCell id="q_s3bg" parent="1" style="rounded=1;html=1;fillColor=#fbfcfe;strokeColor=#d0d7de;arcSize=2;" value="" vertex="1">
                    <mxGeometry height="230" width="1720" x="40" y="870" as="geometry"/>
                </mxCell>
                <mxCell id="q_h3" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" value="③ 同一个问题，三种查询各用各的键" vertex="1">
                    <mxGeometry height="26" width="1400" x="60" y="882" as="geometry"/>
                </mxCell>
                <mxCell id="q_q1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=12;" value="&lt;b&gt;因果查询 · pose_id&lt;/b&gt;　&lt;font style='font-size:10px' color='#8f6a20'&gt;离线 / 诊断&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ticks WHERE id_a ≤ P &amp;lt; id_b&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;→ 这帧 VR 目标影响过的全部关节指令&lt;/i&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="140" width="520" x="80" y="920" as="geometry"/>
                </mxCell>
                <mxCell id="q_q2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;fontSize=12;" value="&lt;b&gt;同拍配对 · tick_seq&lt;/b&gt;　&lt;font style='font-size:10px' color='#38761d'&gt;实时&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;q_cmd.tick_seq == q_fb.tick_seq&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;→ 领先量 q_cmd−q_fb、跟踪误差&lt;/i&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="140" width="520" x="620" y="920" as="geometry"/>
                </mxCell>
                <mxCell id="q_q3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;fontSize=12;" value="&lt;b&gt;延迟测量 · stamp&lt;/b&gt;　&lt;font style='font-size:10px' color='#674ea7'&gt;需时钟同步（PTP / chrony）&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Δt = t_now − t_stamp(id_ack)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;&lt;i&gt;→ 端到端延迟、卡顿定位&lt;/i&gt;&lt;/font&gt;" vertex="1">
                    <mxGeometry height="140" width="520" x="1160" y="920" as="geometry"/>
                </mxCell>
                <mxCell id="q_s4bg" parent="1" style="rounded=1;html=1;fillColor=#fdf8f0;strokeColor=#d79b00;strokeWidth=2;arcSize=2;dashed=1;" value="" vertex="1">
                    <mxGeometry height="190" width="1720" x="40" y="1120" as="geometry"/>
                </mxCell>
                <mxCell id="q_h4" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#8f4a1f;" value="④ 契约约束 —— 这三条不写进协议，前面的对齐全是假的" vertex="1">
                    <mxGeometry height="26" width="1400" x="60" y="1132" as="geometry"/>
                </mxCell>
                <mxCell id="q_c1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b style='font-size:13px'&gt;① 保活帧&lt;/b&gt;&lt;br&gt;pose_id 按 30Hz &lt;b&gt;无条件递增&lt;/b&gt;：手不动也发帧，id 照涨。&lt;br&gt;否则'id 停滞'分不清是静止还是断链，&lt;br&gt;所有超时判据（→ HOLD）全部失效。" vertex="1">
                    <mxGeometry height="125" width="520" x="80" y="1168" as="geometry"/>
                </mxCell>
                <mxCell id="q_c2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b style='font-size:13px'&gt;② HOLD 时冻结溯源标签&lt;/b&gt;&lt;br&gt;QP 解不出时 q_cmd 保持上一帧，&lt;br&gt;(id_a, id_b, α) 也冻结在最后成功的那帧。&lt;br&gt;否则会谎报'这拍在追新目标'。" vertex="1">
                    <mxGeometry height="125" width="520" x="620" y="1168" as="geometry"/>
                </mxCell>
                <mxCell id="q_c3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b style='font-size:13px'&gt;③ ack 语义要写死&lt;/b&gt;&lt;br&gt;pose_id_ack = 该 id 的影响已 &lt;b&gt;全部下发&lt;/b&gt;，&lt;br&gt;不等于'已执行到位'。&lt;br&gt;做超时保护够用，做精度评估不够。" vertex="1">
                    <mxGeometry height="125" width="520" x="1160" y="1168" as="geometry"/>
                </mxCell>
            <mxCell id="q_s5bg" parent="1" style="rounded=1;html=1;fillColor=#f2f8f7;strokeColor=#0e8088;strokeWidth=2;arcSize=2;" value="" vertex="1"><mxGeometry x="40" y="1340" width="1720" height="265" as="geometry"/></mxCell><mxCell id="q_h5" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;fontColor=#0b5f66;" value="⑤ 视觉采集的帧对齐 —— pose_id 的第四个用途（数据集 / 时延分析 / 多模态标定）" vertex="1"><mxGeometry x="60" y="1352" width="1600" height="26" as="geometry"/></mxCell><mxCell id="q_v1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e8088;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;相机 / 传感器&lt;/b&gt;　&lt;font style='font-size:10px' color='#666666'&gt;15 / 30 / 60 Hz 任意&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;图像帧本身&lt;b&gt;不带 id&lt;/b&gt;&lt;br&gt;只有本地到达时刻&lt;br&gt;帧率不必与遥操相同" vertex="1"><mxGeometry x="80" y="1410" width="320" height="135" as="geometry"/></mxCell><mxCell id="q_v2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e8088;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;打标：取当前插值区间&lt;/b&gt;　&lt;font style='font-size:10px' color='#0b5f66'&gt;零额外同步&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;图像到达时刻 → (id_a, id_b, α)&lt;br&gt;与遥操目标共用同一个插值器状态&lt;br&gt;不依赖跨机时钟" vertex="1"><mxGeometry x="440" y="1410" width="360" height="135" as="geometry"/></mxCell><mxCell id="q_v3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0e8088;align=left;verticalAlign=top;spacing=8;fontSize=11;" value="&lt;b&gt;样本（自描述）&lt;/b&gt;&lt;br&gt;─────────&lt;br&gt;{ image_k, (id_a, id_b, α), q_fb, T_actual }&lt;br&gt;─────────&lt;br&gt;离线可精确重建该时刻的&lt;br&gt;目标位姿与实际位姿" vertex="1"><mxGeometry x="840" y="1410" width="380" height="135" as="geometry"/></mxCell><mxCell id="q_v4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f8f7;strokeColor=#0e8088;align=left;verticalAlign=top;spacing=8;fontSize=10;" value="&lt;b&gt;为什么用 id 而不是时间戳&lt;/b&gt;&lt;br&gt;· 图像和目标常来自不同设备，时钟不同源&lt;br&gt;· id 单调，区间定位无歧义&lt;br&gt;· 帧率不同也能落进同一套区间&lt;br&gt;&lt;b&gt;→ 控制链、数据集、时延分析共用一套对齐口径&lt;/b&gt;" vertex="1"><mxGeometry x="1260" y="1410" width="460" height="135" as="geometry"/></mxCell><mxCell id="q_va1" parent="1" edge="1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;endFill=1;endSize=6;"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="1477" as="sourcePoint"/><mxPoint x="440" y="1477" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q_va2" parent="1" edge="1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;endFill=1;endSize=6;"><mxGeometry relative="1" as="geometry"><mxPoint x="800" y="1477" as="sourcePoint"/><mxPoint x="840" y="1477" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q_va3" parent="1" edge="1" style="endArrow=block;html=1;strokeWidth=2;strokeColor=#333333;endFill=1;endSize=6;"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="1477" as="sourcePoint"/><mxPoint x="1260" y="1477" as="targetPoint"/></mxGeometry></mxCell><mxCell id="q_vnote" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#0b5f66;" value="→ 这就是模仿学习数据集里「观测-动作对齐」的通用解：每帧样本自带 (id_a, id_b, α)，不用事后拿时间戳硬配；多相机不同帧率也都能落到同一套 pose 区间上。" vertex="1"><mxGeometry x="80" y="1560" width="1640" height="22" as="geometry"/></mxCell></root>
        </mxGraphModel>
    </diagram>
