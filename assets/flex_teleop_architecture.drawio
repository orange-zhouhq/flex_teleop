                <mxCell id="c_k2" edge="1" parent="1" style="endArrow=none;html=1;strokeColor=#888888;strokeWidth=1;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="634" y="760" as="sourcePoint"/>
                        <mxPoint x="634" y="766" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c_k3" edge="1" parent="1" style="endArrow=none;html=1;strokeColor=#888888;strokeWidth=1;">
                    <mxGeometry relative="1" as="geometry">
                        <mxPoint x="1300" y="760" as="sourcePoint"/>
