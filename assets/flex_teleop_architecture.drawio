                </mxCell>
                <mxCell id="q_r2c4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f1f8f1;strokeColor=#82b366;fontSize=10;" value="&lt;b style='color:#38761d'&gt;跨机对齐&lt;/b&gt; —— 两机基数不同，且不跨机器存在" vertex="1">
