                <mxCell id="q_note1" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#555555;" value="α 序列：0 → .15 → .30 → .45 → .60 → .75 → .90 → &lt;b style='color:#b45f06'&gt;.05&lt;/b&gt; → .20 → .35 …　每 3 帧（40 个 tick）循环一次，不会均匀 0→1 —— 这就是 20:3 的锯齿" vertex="1">
                    <mxGeometry height="18" width="1440" x="200" y="478" as="geometry"/>
