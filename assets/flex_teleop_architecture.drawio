                        <mxPoint x="1360" y="358" as="sourcePoint"/>
                        <mxPoint x="1400" y="358" as="targetPoint"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="c_qfbt2" parent="1" style="text;html=1;fontSize=11;align=right;verticalAlign=middle;fontColor=#674ea7;" value="不进目标生成 → &lt;b&gt;外环不闭合&lt;/b&gt;" vertex="1">
                    <mxGeometry height="22" width="280" x="1000" y="476" as="geometry"/>
                </mxCell>
                <mxCell id="c_obs" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7f2fa;strokeColor=#9673a6;strokeWidth=2;align=left;verticalAlign=top;spacing=8;fontSize=10;" value="&lt;b style='color:#674ea7;font-size:12px'&gt;真实状态观测（不参与控制）&lt;/b&gt;&lt;br&gt;&lt;br&gt;q_fb ──▶ &lt;b&gt;FK(q_fb)&lt;/b&gt; ──▶ &lt;b&gt;T_actual&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;e_model&lt;/b&gt; = r − FK(q_prev)　&lt;i&gt;IK 模型内残差&lt;/i&gt;&lt;br&gt;&lt;b&gt;e_real&lt;/b&gt;　 = r − FK(q_fb)　　&lt;i&gt;真实跟踪误差&lt;/i&gt;&lt;br&gt;&lt;b&gt;Δq&lt;/b&gt;　　　 = q_cmd − q_fb　　&lt;i&gt;伺服领先量&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;e_real ≈ e_model + J·Δq&lt;/b&gt;&lt;br&gt;&lt;i&gt;→ 只看 e_model，会把'伺服没跟上'&lt;br&gt;误判为'跟踪良好'&lt;/i&gt;" vertex="1">
                    <mxGeometry height="220" width="380" x="1400" y="250" as="geometry"/>
                </mxCell>
                <mxCell id="c_l1" parent="1" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#666666;" value="T1 = 33.3 ms" vertex="1">
                    <mxGeometry height="18" width="110" x="185" y="296" as="geometry"/>
                </mxCell>
                <mxCell id="c_l2" parent="1" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#666666;" value="τ + σ（抖动）" vertex="1">
                    <mxGeometry height="18" width="110" x="325" y="296" as="geometry"/>
                </mxCell>
                <mxCell id="c_l3" parent="1" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#8f4a1f;fontStyle=1;" value="延迟 = T1，sinc² 低通" vertex="1">
                    <mxGeometry height="18" width="140" x="465" y="296" as="geometry"/>
                </mxCell>
                <mxCell id="c_l4" parent="1" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#666666;" value="T2 = 5 ms" vertex="1">
                    <mxGeometry height="18" width="110" x="635" y="296" as="geometry"/>
                </mxCell>
                <mxCell id="c_l6" parent="1" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#666666;" value="K = 0.5 / step ≈ 22 Hz" vertex="1">
                    <mxGeometry height="18" width="120" x="845" y="296" as="geometry"/>
                </mxCell>
                <mxCell id="c_l7" parent="1" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#666666;" value="离散累加" vertex="1">
                    <mxGeometry height="18" width="56" x="985" y="296" as="geometry"/>
                </mxCell>
                <mxCell id="c_l8" parent="1" style="text;html=1;fontSize=9;align=center;verticalAlign=middle;fontColor=#666666;" value="f_bw ≈ 20 Hz" vertex="1">
                    <mxGeometry height="18" width="100" x="1205" y="296" as="geometry"/>
                </mxCell>
                <mxCell id="c_chain" parent="1" style="text;html=1;fontSize=10;align=left;verticalAlign=middle;fontColor=#333333;" value="级联结构：&lt;b&gt;C_QP（比例） → ∫（200Hz 累加） → Ruckig（1kHz 整形） → G_s（一阶低通）&lt;/b&gt;　= 位置跟踪系统；外环不引入稳定性约束，只影响跟踪误差与领先量。" vertex="1">
                    <mxGeometry height="22" width="1500" x="200" y="530" as="geometry"/>
                </mxCell>
                <mxCell id="c_note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0f6ff;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;fontSize=10;" value="&lt;b&gt;为什么不怕失稳&lt;/b&gt;&lt;br&gt;外环没有闭合回路：q_fb 只做诊断，&lt;br&gt;H 和 IK 的输出不依赖实际关节角。&lt;br&gt;稳定性由驱动器内环独立保证。" vertex="1">
                    <mxGeometry height="100" width="410" x="1330" y="110" as="geometry"/>
                </mxCell>
                <mxCell id="c_s2bg" parent="1" style="rounded=1;html=1;fillColor=#fafafa;strokeColor=#d0d7de;arcSize=2;" value="" vertex="1">
                    <mxGeometry height="340" width="1720" x="40" y="590" as="geometry"/>
                </mxCell>
                <mxCell id="c_h2" parent="1" style="text;html=1;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;" value="② 延迟预算：约 66.5 ms 端到端，其中 33.3 ms 是主动引入的" vertex="1">
                    <mxGeometry height="26" width="1400" x="60" y="602" as="geometry"/>
                </mxCell>
                <mxCell id="c_b1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#b4c7e7;strokeColor=#ffffff;strokeWidth=2;fontSize=9;align=center;" value="VR 采样保持&lt;br&gt;16.7 ms（T1/2 均值）" vertex="1">
                    <mxGeometry height="60" width="334" x="200" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="c_b2" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d9d9d9;strokeColor=#ffffff;strokeWidth=2;fontSize=9;align=center;" value="网络&lt;br&gt;5 ms" vertex="1">
                    <mxGeometry height="60" width="100" x="534" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="c_b3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f4b183;strokeColor=#ffffff;strokeWidth=2;fontSize=10;align=center;" value="&lt;b&gt;重构器（固定延迟）&lt;br&gt;33.3 ms = T1&lt;/b&gt;" vertex="1">
                    <mxGeometry height="60" width="666" x="634" y="700" as="geometry"/>
                </mxCell>
                <mxCell id="c_b4" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#a9d18e;strokeColor=#ffffff;strokeWidth=2;" value="" vertex="1">
