                    <mxGeometry height="65" width="280" x="280" y="650" as="geometry"/>
                </mxCell>
                <mxCell id="q_r1c3" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8ef;strokeColor=#d79b00;fontSize=10;" value="帧身份 / 乱序丢弃 / 丢帧判定 / 因果 group key&lt;br&gt;（全链只读，永不重生）" vertex="1">
