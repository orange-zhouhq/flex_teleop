                <mxCell id="swA" parent="1" style="swimlane;horizontal=1;startSize=28;container=1;collapsible=0;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f4f8fd;strokeColor=#b0b8c4;" value="TARGET · 数据契约（每一级实际传递的目标对象）" vertex="1">
                    <mxGeometry height="205" width="2240" x="20" y="60" as="geometry"/>
                </mxCell>
                <mxCell id="t0" parent="swA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;TARGET · VrPose&lt;/b&gt;　&lt;font style='font-size:10px' color='#666666'&gt;30Hz 产出&lt;/font&gt;&lt;br&gt;────────────&lt;br&gt;pose_id　← 本帧&lt;b&gt;新分配&lt;/b&gt;&lt;br&gt;stamp_vr（VR 本地时钟）&lt;br&gt;left_pose / right_pose / head_pose&lt;br&gt;　OpenXR 原始世界系，未处理&lt;br&gt;valid_L / valid_R / head_valid&lt;br&gt;pinch_L / pinch_R（透传）" vertex="1">
                    <mxGeometry height="160" width="250" x="30" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="t1" parent="swA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;TARGET · TargetPose30&lt;/b&gt;　&lt;font style='font-size:10px' color='#666666'&gt;30Hz 产出&lt;/font&gt;&lt;br&gt;────────────&lt;br&gt;pose_id　← &lt;b&gt;原样透传&lt;/b&gt;，不重生&lt;br&gt;stamp_vr&lt;br&gt;T_base_tcp[L/R] =&lt;br&gt;　T_base_vr · T_vr_tcp&lt;br&gt;side（left / right）&lt;br&gt;pinch（夹爪映射）&lt;br&gt;&lt;i&gt;锚点/基系变换在本地，不上行&lt;/i&gt;" vertex="1">
                    <mxGeometry height="160" width="250" x="350" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="t2" parent="swA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;TARGET · 下行帧&lt;/b&gt;　&lt;font style='font-size:10px' color='#666666'&gt;30Hz 到达&lt;/font&gt;&lt;br&gt;────────────&lt;br&gt;TargetPose30（整帧）&lt;br&gt;到达时刻 t_rx（机器人时钟）&lt;br&gt;QoS：BEST_EFFORT / KEEP_LAST(1)&lt;br&gt;每帧绝对位姿自描述&lt;br&gt;&lt;i&gt;丢一帧无感：下一帧完整覆盖&lt;/i&gt;" vertex="1">
                    <mxGeometry height="160" width="250" x="670" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="t3" parent="swA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;TARGET · TargetPose200&lt;/b&gt;　&lt;font style='font-size:10px' color='#666666'&gt;200Hz 产出&lt;/font&gt;&lt;br&gt;────────────&lt;br&gt;&lt;b&gt;(pose_id_a, pose_id_b, α)&lt;/b&gt;&lt;br&gt;T_target = interp(T_a, T_b, α)&lt;br&gt;　位置 lerp / 姿态 slerp（注意四元数符号）&lt;br&gt;stamp_exec（执行时刻）&lt;br&gt;&lt;i&gt;★ 每一拍都可无损溯源到&lt;br&gt;两个源关键帧与插值比例&lt;/i&gt;" vertex="1">
                    <mxGeometry height="160" width="250" x="990" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="t4" parent="swA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;TARGET · JointCmd200&lt;/b&gt;　&lt;font style='font-size:10px' color='#666666'&gt;200Hz 产出&lt;/font&gt;&lt;br&gt;────────────&lt;br&gt;q_cmd[7]（关节角指令）&lt;br&gt;(pose_id_a, pose_id_b, α)&lt;br&gt;　随解携带&lt;br&gt;tick_seq（200Hz 拍号）&lt;br&gt;branch / phi（冗余标注）&lt;br&gt;solve_state = TRACKING / HOLD / ..." vertex="1">
                    <mxGeometry height="160" width="250" x="1310" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="t5" parent="swA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;TARGET · JointStreamTarget&lt;/b&gt;　&lt;font style='font-size:10px' color='#666666'&gt;200Hz&lt;/font&gt;&lt;br&gt;────────────&lt;br&gt;q_cmd[7] + tick_seq&lt;br&gt;(pose_id_a, pose_id_b, α)&lt;br&gt;mode：pose / joint&lt;br&gt;────────────&lt;br&gt;&lt;b&gt;两个入口汇聚：&lt;/b&gt;&lt;br&gt;⑤ QP IK 200Hz&lt;br&gt;上层关节 30Hz（旁路 IK）" vertex="1">
                    <mxGeometry height="160" width="250" x="1630" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="t6" parent="swA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;TARGET · RuckigOut 1kHz&lt;/b&gt;　&lt;font style='font-size:10px' color='#666666'&gt;1kHz&lt;/font&gt;&lt;br&gt;────────────&lt;br&gt;q_ref[7]（位置 / 速度 / 加速度）&lt;br&gt;jerk 限幅后的连续轨迹&lt;br&gt;────────────&lt;br&gt;q_fb[7]（驱动器反馈）&lt;br&gt;qd / τ&lt;br&gt;pose_id_ack（200Hz 层填）" vertex="1">
                    <mxGeometry height="160" width="250" x="1950" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="swB" parent="1" style="swimlane;horizontal=1;startSize=28;container=1;collapsible=0;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#fafafa;strokeColor=#b0b8c4;" value="处理环节（按频率域串联）" vertex="1">
                    <mxGeometry height="195" width="2240" x="20" y="290" as="geometry"/>
                </mxCell>
                <mxCell id="p0" parent="swB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;① VR 采集&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;30 Hz · OpenXR&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;只采集、只透传&lt;br&gt;不做任何坐标处理&lt;br&gt;每帧分配 pose_id&lt;br&gt;跟踪丢失 → valid=false" vertex="1">
                    <mxGeometry height="125" width="250" x="30" y="38" as="geometry"/>
                </mxCell>
                <mxCell id="p1" parent="swB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;② 坐标转换 / 遥操映射&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;30 Hz · PC 侧&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;T_base_tcp = T_base_vr · T_vr_tcp&lt;br&gt;锚点标定 / 头参考补偿&lt;br&gt;工作区重定位（增益+偏移）&lt;br&gt;&lt;i&gt;pose_id 原样透传，不重生&lt;/i&gt;" vertex="1">
                    <mxGeometry height="125" width="250" x="350" y="38" as="geometry"/>
                </mxCell>
                <mxCell id="p2" parent="swB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;③ 下行传输&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;30 Hz · 网络&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;整帧绝对位姿，自描述&lt;br&gt;丢帧由下一帧覆盖&lt;br&gt;&lt;i&gt;stamp 跨机不同源&lt;br&gt;→ 帧身份只认 pose_id&lt;/i&gt;" vertex="1">
                    <mxGeometry height="125" width="250" x="670" y="38" as="geometry"/>
                </mxCell>
                <mxCell id="p3" parent="swB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;④ 帧对齐缓冲 + 插值&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;200 Hz · 机器人侧&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;双缓存 (A, B) + 时间比 α&lt;br&gt;α = (t − t_A) / (t_B − t_A)&lt;br&gt;位置 lerp / 姿态 slerp&lt;br&gt;&lt;i&gt;固定延迟（推荐，吸收抖动）&lt;br&gt;或追赶（α 钳 1，有阶梯）&lt;/i&gt;" vertex="1">
                    <mxGeometry height="125" width="250" x="990" y="38" as="geometry"/>
                </mxCell>
                <mxCell id="p4" parent="swB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;⑤ QP 速度级 IK&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;200 Hz · 每拍一次 QP&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;min ½dqᵀH dq + gᵀdq&lt;br&gt;s.t. 盒约束 dq ∈ [限位 ∩ 速度]&lt;br&gt;q_cmd = q_prev + dq（一步积分）&lt;br&gt;&lt;i&gt;解不出 → HOLD 上一帧&lt;br&gt;连续 hold → 上报 DEGRADED&lt;/i&gt;" vertex="1">
                    <mxGeometry height="125" width="250" x="1310" y="38" as="geometry"/>
                </mxCell>
                <mxCell id="p5" parent="swB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;⑥ 关节流式目标（汇聚）&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;200 Hz · 连续流&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;入口 A：QP IK 200Hz（pose 模式）&lt;br&gt;入口 B：上层关节 30Hz（joint 模式）&lt;br&gt;按最近一帧仲裁，模式切换做平滑交接&lt;br&gt;看门狗：超时 → 安全停" vertex="1">
                    <mxGeometry height="125" width="250" x="1630" y="38" as="geometry"/>
                </mxCell>
                <mxCell id="p6" parent="swB" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#333333;strokeWidth=2;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;⑦ Ruckig OTG 1kHz&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#666666'&gt;1 kHz · 在线轨迹生成&lt;/font&gt;&lt;br&gt;─────────&lt;br&gt;200Hz 目标 → 1kHz 平滑轨迹&lt;br&gt;约束 v_max / a_max / j_max&lt;br&gt;─────────&lt;br&gt;伺服：位置环 → 电流环&lt;br&gt;回读 q_fb / qd / τ" vertex="1">
                    <mxGeometry height="125" width="250" x="1950" y="38" as="geometry"/>
                </mxCell>
                <mxCell id="f01" edge="1" parent="swB" source="p0" style="edgeStyle=none;html=1;rounded=0;strokeWidth=3;strokeColor=#333333;endArrow=block;endFill=1;endSize=6;" target="p1">
