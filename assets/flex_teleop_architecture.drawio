                <mxCell id="f45" edge="1" parent="swB" source="p4" style="edgeStyle=none;html=1;rounded=0;strokeWidth=3;strokeColor=#333333;endArrow=block;endFill=1;endSize=6;" target="p5">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="f56" edge="1" parent="swB" source="p5" style="edgeStyle=none;html=1;rounded=0;strokeWidth=3;strokeColor=#333333;endArrow=block;endFill=1;endSize=6;" target="p6">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="swC" parent="1" style="swimlane;horizontal=1;startSize=28;container=1;collapsible=0;html=1;whiteSpace=wrap;fontStyle=1;fontSize=13;fillColor=#f4faf4;strokeColor=#b0b8c4;" value="STATE · 本地状态与诊断（不随消息传递，逐级自持）" vertex="1">
                    <mxGeometry height="205" width="2240" x="20" y="505" as="geometry"/>
                </mxCell>
                <mxCell id="s0" parent="swC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;STATE · VR 侧&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;valid_L / valid_R / head_valid&lt;br&gt;设备 · 手柄连接状态&lt;br&gt;采样周期抖动（30Hz ± jitter）&lt;br&gt;pose_id 计数器&lt;br&gt;stamp_vr（VR 本地时钟）" vertex="1">
                    <mxGeometry height="160" width="250" x="30" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="s1" parent="swC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;STATE · 遥操映射参数&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;T_base_vr 标定锚点&lt;br&gt;重定位偏移（工作区映射）&lt;br&gt;操作者身高 / 坐站模式&lt;br&gt;失效保持标志&lt;br&gt;&lt;i&gt;valid=false → 冻结目标不跳变&lt;/i&gt;" vertex="1">
                    <mxGeometry height="160" width="250" x="350" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="s2" parent="swC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;STATE · 接收侧&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;最新帧缓冲（KEEP_LAST(1)）&lt;br&gt;t_rx、传输延迟估计&lt;br&gt;丢帧 / 乱序计数&lt;br&gt;看门狗：超时 → HOLD&lt;br&gt;&lt;i&gt;id ≤ max_seen → 直接丢弃&lt;/i&gt;" vertex="1">
                    <mxGeometry height="160" width="250" x="670" y="32" as="geometry"/>
                </mxCell>
                <mxCell id="s3" parent="swC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=4;spacingLeft=8;spacingRight=8;fontSize=11;" value="&lt;b&gt;STATE · 插值器&lt;/b&gt;&lt;br&gt;────────────&lt;br&gt;关键帧双缓存 (T_a,id_a)、(T_b,id_b)&lt;br&gt;α ∈ [0, 1]&lt;br&gt;新帧标志（id 推进才换帧）&lt;br&gt;无新帧计数（超时 → HOLD）&lt;br&gt;固定延迟 Δt（如 1 帧周期+裕量）&lt;br&gt;&lt;i&gt;首帧只有 A：hold 到 B 到达&lt;/i&gt;" vertex="1">
                    <mxGeometry height="160" width="250" x="990" y="32" as="geometry"/>
